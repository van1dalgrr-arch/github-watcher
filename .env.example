# Обычно ничего задавать не нужно: токен берётся из `gh auth login`,
# Telegram настраивает `gw telegram <bot-token>` (пишет в ~/.config/gw/config).
# Переменные окружения важнее файла настроек.

GITHUB_TOKEN=

# демон
PORT=7777
# по умолчанию ~/.local/share/gw/gw.db
GW_DB=
POLL_INTERVAL=1m
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# пусто — важное; all — всё; или список: ci_failed,mention,pr_review
NOTIFY_KINDS=
# пусто — все; или owner/a,owner/b
NOTIFY_REPOS=

# куда TUI ходит за лентой (если демон на сервере)
GW_DAEMON_URL=http://localhost:7777
